SANITY_STUDIO_SANITY_PROJECT_TITLE=
SANITY_STUDIO_SANITY_DATASET=
SANITY_STUDIO_SANITY_PROJECT_ID=
# Optional: POST endpoint for tone suggestions (see lib/toneOfVoiceSuggest.ts)
# After running `yarn server:tone`, use:
# SANITY_STUDIO_TONE_SUGGESTIONS_URL=http://localhost:3847/tone-suggestions
SANITY_STUDIO_TONE_SUGGESTIONS_URL=

# Express tone server (server/tone-suggestions.ts) — do not commit real keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
TONE_SUGGESTIONS_PORT=3847
# Comma-separated origins for CORS; leave empty to allow all (dev only)
CORS_ORIGIN=